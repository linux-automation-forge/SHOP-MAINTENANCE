-# CLI command: publish [--dry-run] <barcode> | all
-cmd_publish() {
-    local dry=0
-    [[ "${1:-}" == "--dry-run" ]] && { dry=1; shift; }
-    local bc="${1:-}"
-    [[ -n "$bc" ]] || { err "Usage: shopkeep.sh publish [--dry-run] <barcode> | all"; return 3; }
-    if [[ "$bc" == "all" ]]; then
-        init_dirs; lock; load_products; unlock
-        local b n=0 published=0
