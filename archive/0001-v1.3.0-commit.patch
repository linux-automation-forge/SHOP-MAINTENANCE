-# Clock — IST forced via TZ=Asia/Kolkata (Chennai, UTC+05:30). Fixed English
-# abbreviations so the header stays neat in every UI language, refreshed on
-# every menu redraw.
-now_date() { LC_ALL=C TZ=Asia/Kolkata date '+%a %d %b %Y'; }
