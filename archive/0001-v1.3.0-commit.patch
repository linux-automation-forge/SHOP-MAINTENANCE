-#─────────────────────────────────────────────────────────────────────────────
-# Money math — all integer paise
-#─────────────────────────────────────────────────────────────────────────────
-# parse "25", "25.5", "25.00", "25.05" -> integer paise. No floating point.
-rupees_to_paise() {
-    local input="$1"
-    [[ "$input" =~ ^[0-9]+(\.[0-9]{0,2})?$ ]] || return 1
-    local int_part frac_part
-    if [[ "$input" == *.* ]]; then
-        int_part="${input%%.*}"
-        frac_part="${input#*.}"
-        case ${#frac_part} in
-            0) frac_part="00" ;;
-            1) frac_part="${frac_part}0" ;;
-        esac
-    else
-        int_part="$input"
-        frac_part="00"
-    fi
-    local result="${int_part}${frac_part}"
-    printf '%s' "$((10#$result))"
-}
