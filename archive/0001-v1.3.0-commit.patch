+;
+var DATA=null,LIVE=false,SORT={key:"name",dir:1},LOGFILTER="ALL";
+function $(id){return document.getElementById(id);}
+function esc(s){s=String(s==null?"":s);return s.replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];});}
+function fmt(p){p=Math.round(Number(p)||0);var sign=p<0?"-":"",a=Math.abs(p);return sign+"\u20B9"+Math.floor(a/100)+"."+String(a%100).padStart(2,"0");}
+function pad(n){return String(n).padStart(2,"0");}
+function istNow(){try{return new Date(new Date().toLocaleString("en-US",{timeZone:"Asia/Kolkata"}));}catch(e){return new Date();}}
+function istDateStr(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());}
+function todayIST(){return (!LIVE&&DATA&&DATA.meta&&DATA.meta.today)?DATA.meta.today:istDateStr(istNow());}
+function tick(){var d=istNow();$("clock").textContent=istDateStr(d)+" "+pad(d.getHours())+":"+pad(d.getMinutes())+":"+pad(d.getSeconds())+" IST";}
+function detectLive(){
+  var ctrl=("AbortController" in window)?new AbortController():null;
+  var opts=ctrl?{signal:ctrl.signal}:{};
+  var timer=ctrl?setTimeout(function(){ctrl.abort();},2500):null;
+  return fetch("/api/products.json",opts).then(function(r){
+    if(timer)clearTimeout(timer);return !!r.ok;
+  }).catch(function(){if(timer)clearTimeout(timer);return false;});
+}
+function fetchJSON(u){return fetch(u).then(function(r){if(!r.ok)throw new Error(u+" -> HTTP "+r.status);return r.json();});}
+function loadLive(){
+  return Promise.all([fetchJSON("/api/products.json"),fetchJSON("/api/bills.json"),
+    fetchJSON("/api/categories.json"),fetchJSON("/api/trays.json"),
+    fetchJSON("/api/inventorylog.json")]).then(function(p){
+    DATA={products:p[0],bills:p[1],categories:p[2],trays:p[3],inventoryLog:p[4],meta:SNAPSHOT.meta};});
+}
+function boot(){
+  detectLive().then(function(live){
+    if(!live)return null;
+    return loadLive().then(function(){LIVE=true;}).catch(function(){LIVE=false;});
+  }).catch(function(){LIVE=false;}).then(function(){
+    if(!DATA)DATA=SNAPSHOT;
+    if(LIVE){$("modebadge").textContent="LIVE";$("modebadge").className="badge live";}
+    else{$("modebadge").textContent="SNAPSHOT";$("modebadge").className="badge snap";
+         $("banner").style.display="block";$("billpanel").style.display="none";}
+    $("ver").textContent="shopkeep "+(DATA.meta.version||"")+" — "+(LIVE?"live mode":"snapshot generated "+(DATA.meta.generatedIST||"")+" IST");
+    renderAll();setInterval(tick,1000);tick();
+  });
+}
+function refresh(){if(LIVE){loadLive().then(renderAll).catch(function(){});}}
+function renderAll(){renderHeader();renderProducts();renderCats();renderSales();renderLog();}
+function renderHeader(){
+  $("shopname").textContent=DATA.meta.shopName||"My Shop";
