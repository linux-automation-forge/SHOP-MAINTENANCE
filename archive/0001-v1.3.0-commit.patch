-init_dirs() {
-    mkdir -p "$DATA_DIR" "$LABELS_DIR" "$BACKUPS_DIR"
-    [[ -f "$PRODUCTS_CSV" ]]   || printf '%s\n' "$PRODUCTS_HEADER" > "$PRODUCTS_CSV"
-    migrate_products_csv
