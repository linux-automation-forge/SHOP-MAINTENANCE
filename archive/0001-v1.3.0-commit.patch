-# Truncate by DISPLAY width (not chars) so tables never break mid-glyph.
-truncate_disp() {
-    local s="$1" maxw="$2" out="" i ch total=0
-    for ((i=0; i<${#s}; i++)); do
-        ch="${s:i:1}"
-        _dw "$ch"
-        if (( total + _DW > maxw )); then break; fi
