+# NEW (v1.3.0): after lock/unlock the process stderr must still point where it
+# pointed before — the old unlock() exec'd 2>/dev/null permanently.
+_st_unlock_stderr() {
+    local before after
+    before=$(readlink /proc/self/fd/2 2>/dev/null) || true
+    [[ -z "$before" ]] && return 0   # no /proc (macOS/BSD) — nothing to assert
+    lock; unlock
+    after=$(readlink /proc/self/fd/2 2>/dev/null) || true
+    [[ -n "$after" && "$after" == "$before" ]]
