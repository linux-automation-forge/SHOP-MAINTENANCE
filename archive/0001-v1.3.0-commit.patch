+function setSort(k){if(SORT.key===k)SORT.dir=-SORT.dir;else{SORT.key=k;SORT.dir=1;}renderProducts();}
+function renderProducts(){
+  var q=($("psearch").value||"").toLowerCase(),today=todayIST();
+  var rows=DATA.products.filter(function(p){return !q||(p.name+" "+p.barcode+" "+p.type+" "+p.hsnCode).toLowerCase().indexOf(q)>=0;});
+  var k=SORT.key,dir=SORT.dir;
