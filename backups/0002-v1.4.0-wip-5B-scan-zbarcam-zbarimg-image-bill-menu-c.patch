+#═════════════════════════════════════════════════════════════════════════════
+# v1.4.0 Phase 5B — scan / quickbill / import / report / UPI QR
+#
+# Design contracts (locked by review):
+#   * A scan is just another INPUT METHOD — decoded codes enter the exact same
+#     billing path as typed input (same lookup, same 2xxx tray expansion, same
+#     3xxx refusal, same commit_bill). Zero duplicated billing logic.
+#   * quickbill converts its argv into the same "barcode qty" stdin lines and
+#     pushes them through cmd_bill — identical bills.csv rows by construction.
+#   * import validates EVERY row first; one bad row means nothing is written.
+#     Its validation report is fixed-English, machine-parseable text that the
+#     future dashboard can display verbatim.
+#   * report and summary share ONE aggregation core (agg_bills_range), so a
+#     range report always equals the sum of per-day summary runs.
+#   * UPI QR is one conf key (upi_vpa) + one callable URI builder + the
+#     existing gen-qr rendering path. No tools required (SVG fallback).
+#═════════════════════════════════════════════════════════════════════════════
+
+# ── scan ─────────────────────────────────────────────────────────────────────
+scan_hint_install() {
+    err "$(t scan_need_zbar)"
+}
+
+# Decode barcodes from one image via zbarimg. Prints codes one per line.
+# rc 1 (with a clear error) when the file is unreadable or nothing decodes.
+scan_decode_image() {
+    local img="$1"
+    if [[ ! -f "$img" || ! -r "$img" ]]; then
+        err "Cannot read image: $img"
+        return 1
+    fi
+    local out=""
+    out=$(zbarimg -q --raw "$img" 2>/dev/null) || true
+    if [[ -z "${out//[[:space:]]/}" ]]; then
+        err "$(t scan_no_bc): $img"
+        return 1
+    fi
+    printf '%s\n' "$out"
+}
+
+# Live camera scan via zbarcam. Prints codes one per line to stdout as they
+# are decoded; Ctrl-C stops the camera (zbarcam gets the real SIGINT, the
+# shell ignores it and continues after EOF). rc 1 when no camera is present.
+scan_collect_camera() {
+    local cam="" dev
+    for dev in /dev/video*; do
+        [[ -e "$dev" ]] && { cam="$dev"; break; }
+    done
+    if [[ -z "$cam" ]]; then
+        err "$(t scan_no_cam)"
+        return 1
+    fi
+    log "Camera live ($cam) — scan barcodes; press Ctrl-C to finish."
+    local bc
+    while IFS= read -r bc; do
+        [[ -n "$bc" ]] || continue
+        printf '→ scanned: %s\n' "$bc" >&2   # live feedback; stdout stays clean
+        printf '%s\n' "$bc"
+    done < <( { trap - INT; exec zbarcam --raw --nodisplay "$cam"; } 2>/dev/null )
+    return 0
+}
+
+cmd_scan() {
+    local img="" dobill=0
+    while [[ $# -gt 0 ]]; do
+        case "$1" in
+            --image) [[ $# -ge 2 ]] || { err "--image needs a value"; return 3; }; img="$2"; shift 2 ;;
+            --bill)  dobill=1; shift ;;
+            -h|--help) cat <<'EOF'
+shopkeep.sh scan [--image FILE] [--bill]
+  (no --image)  live camera scan via zbarcam; Ctrl-C stops scanning
+  --image FILE  decode barcodes from an image file via zbarimg
+  --bill        bill the decoded barcodes through the normal `bill` path
+                (each decoded code = qty 1; scan twice for qty 2; 2xxx combo
+                trays expand, 3xxx category-tray codes are refused, exactly
+                like typed input)
+Decoded codes are always printed one per line on stdout.
+Requires zbar-tools (sudo apt install zbar-tools) — without it, scan prints
+one install hint and exits 1; normal billing is completely unaffected.
+EOF
+                       return 0 ;;
+            *) err "Unknown argument: $1"; return 3 ;;
+        esac
+    done
+    local out=""
+    if [[ -n "$img" ]]; then
+        command -v zbarimg >/dev/null 2>&1 || { scan_hint_install; return 1; }
+        out=$(scan_decode_image "$img") || return 1
+    else
+        command -v zbarcam >/dev/null 2>&1 || { scan_hint_install; return 1; }
+        trap ':' INT
+        out=$(scan_collect_camera) || { trap - INT; return 1; }
+        trap - INT
+        if [[ -z "${out//[[:space:]]/}" ]]; then
+            err "Nothing scanned."
+            return 1
+        fi
+    fi
+    printf '%s\n' "$out"          # scriptable output: one code per line
+    if (( dobill )); then
+        local rc=0
+        # The decoded codes enter the EXACT same path as `bill` stdin:
+        printf '%s\n' "$out" | cmd_bill || rc=$?
+        return "$rc"
+    fi
+    return 0
+}
+
+# ── quickbill ────────────────────────────────────────────────────────────────
+# One-shot argv billing for scripts and the future dashboard. The BC QTY
+# pairs are converted into the same "barcode qty" lines `bill` reads from
+# stdin, then pushed through cmd_bill — so validation, tray expansion, 3xxx
+# refusal, commit, receipt and CSV rows are IDENTICAL to `bill`.
+cmd_quickbill() {
+    local phone="" dpct="0"
+    local -a pairs=()
+    while [[ $# -gt 0 ]]; do
+        case "$1" in
+            --phone)    [[ $# -ge 2 ]] || { err "--phone needs a value"; return 3; }; phone="$2"; shift 2 ;;
+            --discount) [[ $# -ge 2 ]] || { err "--discount needs a value"; return 3; }; dpct="$2"; shift 2 ;;
+            -h|--help) cat <<'EOF'
+shopkeep.sh quickbill [--phone 9876543210] [--discount 0-100] BC QTY [BC QTY...]
+  One-shot billing: every BC QTY pair becomes one cart line and goes through
+  the exact same engine as `bill` (2xxx trays expand, 3xxx refused, identical
+  bills.csv rows and receipt on stdout).
+  Example: quickbill 8901234567890 2 2001 1 --phone 9876543210
+EOF
+                       return 0 ;;
+            --) shift; while (( $# )); do pairs+=("$1"); shift; done; break ;;
+            -*) err "Unknown argument: $1"; return 3 ;;
+            *)  pairs+=("$1"); shift ;;
+        esac
+    done
+    if (( ${#pairs[@]} == 0 )); then
+        err "Usage: shopkeep.sh quickbill [--phone P] [--discount D] BC QTY [BC QTY...]"
+        return 3
+    fi
+    if (( ${#pairs[@]} % 2 != 0 )); then
+        err "quickbill needs BC QTY pairs — got an odd trailing argument: ${pairs[${#pairs[@]}-1]}"
+        return 3
+    fi
+    local input="" i
+    for (( i=0; i<${#pairs[@]}; i+=2 )); do
+        input+="${pairs[i]} ${pairs[i+1]}"$'\n'
+    done
+    local rc=0
+    printf '%s' "$input" | cmd_bill --phone "$phone" --discount "$dpct" || rc=$?
+    return "$rc"
+}
+
+# ── import ───────────────────────────────────────────────────────────────────
+# Bulk product import. ALL-OR-NOTHING: every row is validated before any
+# write; one bad row aborts the whole import. The report is plain fixed-
+# English text (CSV data stays English too), so the future dashboard can
+# return it verbatim in a GUI dialog:
+#   ERR row <n>: <reason>            (per failing row)
+#   OK add <bc> <name> price_paise=<p> qty=<q>   (per accepted row)
+#   SUMMARY rows=<R> ok=<O> err=<E>
+#   RESULT dry-run — nothing written | RESULT imported <O> products
+#                    | RESULT failed — nothing written
+IMPORT_REPORT=()   # report lines from the last import_validate run
+IMPORT_ROWS=()     # validated rows, US-separated: bc<US>name<US>price...
+IMPORT_WOULD=0
+IMPORT_ERRS=0
+IMPORT_INPUT_ROWS=0
+
+import_validate() {   # $1 = file. Read-only: writes NOTHING. rc 0 = clean.
+    IMPORT_REPORT=(); IMPORT_ROWS=(); IMPORT_WOULD=0; IMPORT_ERRS=0; IMPORT_INPUT_ROWS=0
+    local file="$1"
+    if [[ ! -f "$file" || ! -r "$file" ]]; then
+        IMPORT_REPORT+=("ERR file: cannot read $file")
+        IMPORT_ERRS=$((IMPORT_ERRS + 1))
+        return 1
+    fi
+    local hdr
+    hdr=$(head -1 "$file" 2>/dev/null || true)
+    if [[ "$hdr" != "$PRODUCTS_HEADER" ]]; then
+        IMPORT_REPORT+=("ERR header: expected [$PRODUCTS_HEADER]")
+        IMPORT_REPORT+=("ERR header: got      [$hdr]")
+        IMPORT_ERRS=$((IMPORT_ERRS + 1))
+        return 1
+    fi
+    load_products   # read-only snapshot for validation (commit re-validates under lock)
+    local -A seen=()   # barcodes claimed by this file so far
+    local line n=0 row_err fbc fname fpp fqty fthr fdesc ftype fimg fexp fhsn errs_in_file=0
+    while IFS= read -r line || [[ -n "$line" ]]; do
+        n=$((n + 1))
+        [[ -z "$line" ]] && continue
+        [[ "$line" == "barcode,"* ]] && continue   # header line (also guards re-imported files)
+        IMPORT_INPUT_ROWS=$((IMPORT_INPUT_ROWS + 1))
+        parse_csv_line "$line"
+        row_err=0
+        if (( ${#CSV_FIELDS[@]} != 10 )); then
+            IMPORT_REPORT+=("ERR row $n: expected 10 fields, got ${#CSV_FIELDS[@]}")
+            errs_in_file=$((errs_in_file + 1))
+            continue
+        fi
+        fbc="${CSV_FIELDS[0]}"; fname="${CSV_FIELDS[1]}"; fpp="${CSV_FIELDS[2]}"; fqty="${CSV_FIELDS[3]}"
+        fthr="${CSV_FIELDS[4]}"; fdesc="${CSV_FIELDS[5]}"; ftype="${CSV_FIELDS[6]}"; fimg="${CSV_FIELDS[7]}"
+        fexp="${CSV_FIELDS[8]}"; fhsn="${CSV_FIELDS[9]}"
+        if [[ -z "$fbc" ]]; then
+            fbc=$(gen_internal_barcode)
+            while [[ -n "${seen[$fbc]+x}" ]]; do fbc=$((fbc + 1)); done
+        fi
+        if ! [[ "$fbc" =~ ^[0-9]+$ ]]; then
+            IMPORT_REPORT+=("ERR row $n: barcode [$fbc] must be digits")
+            row_err=1
+        fi
+        if [[ -z "$fname" ]]; then
+            IMPORT_REPORT+=("ERR row $n: name is empty")
+            row_err=1
+        fi
+        if ! [[ "$fpp" =~ ^[0-9]+$ ]]; then
+            IMPORT_REPORT+=("ERR row $n: price_paise [$fpp] must be integer paise (2500 = Rs 25.00)")
+            row_err=1
+        elif (( 10#$fpp <= 0 )); then
+            IMPORT_REPORT+=("ERR row $n: price_paise must be > 0")
+            row_err=1
+        else
+            fpp=$((10#$fpp))
+        fi
+        if ! [[ "$fqty" =~ ^[0-9]+$ ]]; then
+            IMPORT_REPORT+=("ERR row $n: qty [$fqty] must be >= 0")
+            row_err=1
+        else
+            fqty=$((10#$fqty))
+        fi
+        if [[ -z "$fthr" ]]; then fthr=$(conf default_threshold 8); fi
+        if ! [[ "$fthr" =~ ^[0-9]+$ ]]; then
+            IMPORT_REPORT+=("ERR row $n: threshold [$fthr] must be >= 0")
+            row_err=1
+        else
+            fthr=$((10#$fthr))
+        fi
+        if [[ -n "$fexp" && ! "$fexp" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
+            IMPORT_REPORT+=("ERR row $n: expiry [$fexp] must be YYYY-MM-DD")
+            row_err=1
+        fi
+        if [[ -n "${seen[$fbc]+x}" ]]; then
+            IMPORT_REPORT+=("ERR row $n: duplicate barcode within file: $fbc")
+            row_err=1
+        fi
+        if [[ -n "${P_NAME[$fbc]+x}" ]]; then
+            IMPORT_REPORT+=("ERR row $n: duplicate barcode (exists): $fbc -> ${P_NAME[$fbc]}")
+            row_err=1
+        fi
+        if (( row_err )); then
+            errs_in_file=$((errs_in_file + 1))
+            continue
+        fi
+        seen["$fbc"]=1
+        IMPORT_ROWS+=("$fbc${US}$fname${US}$fpp${US}$fqty${US}$fthr${US}$fdesc${US}$ftype${US}$fimg${US}$fexp${US}$fhsn")
+        IMPORT_WOULD=$((IMPORT_WOULD + 1))
+    done < "$file"
+    IMPORT_ERRS=$((IMPORT_ERRS + errs_in_file))
+    IMPORT_REPORT+=("SUMMARY rows=$IMPORT_INPUT_ROWS ok=$IMPORT_WOULD err=$IMPORT_ERRS")
+    (( IMPORT_ERRS == 0 )) && return 0
+    return 1
+}
+
+import_print_report() {
+    local r
+    for r in ${IMPORT_REPORT[@]+"${IMPORT_REPORT[@]}"}; do
+        printf '%s\n' "$r"
+    done
+}
+
+cmd_import() {
+    local tmpl="" file="" dry=0
+    local -a args=()
+    while [[ $# -gt 0 ]]; do
+        case "$1" in
+            --template)
+                if [[ $# -ge 2 && "${2:0:1}" != "-" ]]; then tmpl="$2"; shift 2
+                else tmpl="$PWD/products-import-template.csv"; shift; fi ;;
+            --dry-run) dry=1; shift ;;
+            -h|--help) cat <<'EOF'
+shopkeep.sh import --template [OUT]      write a template CSV (never clobbers)
+shopkeep.sh import FILE [--dry-run]      validate then bulk-add products
+
+FILE is a CSV with the exact products.csv 10-column header:
+  barcode,name,price_paise,qty,threshold,description,type,image,expiry_date,hsn_code
+  * price is INTEGER PAISE (2500 = Rs 25.00)
+  * blank barcode -> an internal 2xxx code is auto-assigned
+  * blank threshold -> default_threshold from config
+  * one bad row aborts the WHOLE import (all-or-nothing)
+  * --dry-run prints the validation report and writes nothing
+The report is machine-parseable: "ERR row N: ...", "OK add <bc> <name> ...",
+"SUMMARY rows=.. ok=.. err=..", "RESULT ...".
+EOF
+                       return 0 ;;
+            --) shift; while (( $# )); do args+=("$1"); shift; done; break ;;
+            -*) err "Unknown argument: $1"; return 3 ;;
+            *)  args+=("$1"); shift ;;
+        esac
+    done
+    if (( ${#args[@]} > 1 )); then
+        err "import takes at most one FILE"
+        return 3
+    fi
+    (( ${#args[@]} == 1 )) && file="${args[0]}"
+
+    if [[ -n "$tmpl" ]]; then
+        [[ -n "$file" ]] && { err "--template and FILE are mutually exclusive"; return 3; }
+        if [[ -e "$tmpl" ]]; then
+            err "Refusing to overwrite existing file: $tmpl"
+            return 1
+        fi
+        {
+            printf '%s\n' "$PRODUCTS_HEADER"
+            printf '%s\n' '8901234500011,Sample Tea 50g,2500,24,8,example row - edit or delete,Grocery,,2027-12-31,'
+            printf '%s\n' '8901234500012,Sample Soap 100g,3500,12,6,example row,Personal Care,,,'
+        } > "$tmpl"
+        log "Import template written: $tmpl"
+        log "One row per product; price is integer paise (2500 = Rs 25.00);"
+        log "blank barcode = auto internal 2xxx code. Then: ./shopkeep.sh import $tmpl --dry-run"
+        return 0
+    fi
+
+    [[ -n "$file" ]] || { err "Usage: shopkeep.sh import --template [OUT] | FILE [--dry-run]"; return 3; }
+
+    # pass 1 — validate (no lock, no writes)
+    if ! import_validate "$file"; then
+        import_print_report
+        err "RESULT failed — nothing written."
+        return 1
+    fi
+    local r
+    for r in ${IMPORT_ROWS[@]+"${IMPORT_ROWS[@]}"}; do
+        IFS="$US" read -r fbc fname fpp fqty fthr _ _ _ _ _ <<< "$r"
+        printf 'OK add %s %s price_paise=%s qty=%s\n' "$fbc" "$fname" "$fpp" "$fqty"
+    done
+    import_print_report
+    if (( dry )); then
+        log "RESULT dry-run — validation passed, nothing written."
+        return 0
+    fi
+
+    # pass 2 — re-validate under the lock, then commit
+    lock
+    if ! import_validate "$file"; then
+        unlock
+        import_print_report
+        err "RESULT failed — data changed during import, nothing written."
+        return 1
+    fi
+    # categories first (create any missing ones for the type column)
+    local -A cat_done=()
+    for r in ${IMPORT_ROWS[@]+"${IMPORT_ROWS[@]}"}; do
+        IFS="$US" read -r _ _ _ _ _ _ ftype _ _ _ <<< "$r"
+        if [[ -n "$ftype" && -z "${cat_done[$ftype]+x}" ]]; then
+            ensure_category "$ftype" >/dev/null
+            cat_done["$ftype"]=1
+        fi
+    done
+    # products + one ADD log row each
+    local fbc fname fpp fqty fthr fdesc ftype fimg fexp fhsn
+    for r in ${IMPORT_ROWS[@]+"${IMPORT_ROWS[@]}"}; do
+        IFS="$US" read -r fbc fname fpp fqty fthr fdesc ftype fimg fexp fhsn <<< "$r"
+        printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
+            "$(csv_quote "$fbc")" "$(csv_quote "$fname")" "$fpp" "$fqty" "$fthr" \
+            "$(csv_quote "$fdesc")" "$(csv_quote "$ftype")" "$(csv_quote "$fimg")" \
+            "$(csv_quote "$fexp")" "$(csv_quote "$fhsn")" >> "$PRODUCTS_CSV"
+        log_event "ADD" "$fbc" "$fname" "$fqty" "$fpp" \
+            "imported, threshold=$fthr, type=$ftype${fexp:+, expiry=$fexp}${fhsn:+, hsn=$fhsn}"
+    done
+    unlock
+    log "RESULT imported $IMPORT_WOULD products from $file"
+    return 0
+}
+
+# ── report ───────────────────────────────────────────────────────────────────
+# Aggregate sales over [start..end] (IST dates, inclusive). Uses the SAME
+# aggregation core as `summary` (agg_bills_range + _day_stats), so the range
+# totals equal, by construction, the sum of per-day summary runs.
+cmd_report() {
+    local s="${1:-}" e="${2:-}"
+    if [[ -z "$s" || -z "$e" ]]; then
+        err "Usage: shopkeep.sh report <start YYYY-MM-DD> <end YYYY-MM-DD>"
+        return 3
+    fi
+    local re='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
+    if [[ ! "$s" =~ $re ]] || [[ "$(date -d "$s" +%F 2>/dev/null)" != "$s" ]]; then
+        err "Bad start date: $s (use YYYY-MM-DD)"
+        return 1
+    fi
+    if [[ ! "$e" =~ $re ]] || [[ "$(date -d "$e" +%F 2>/dev/null)" != "$e" ]]; then
+        err "Bad end date: $e (use YYYY-MM-DD)"
+        return 1
+    fi
+    if [[ "$e" < "$s" ]]; then
+        err "end date $e is before start date $s"
+        return 1
+    fi
+    init_dirs
+    if [[ ! -s "$BILLS_CSV" ]] || (( $(wc -l < "$BILLS_CSV") <= 1 )); then
+        log "No bills recorded."; return 0
+    fi
+    agg_bills_range "$s" "$e"
+
+    # days present in the range (union of SELL/VOID days), sorted
+    local -a days=()
+    local -A dayseen=()
+    local k d
+    for k in ${AGG_DSELLBILL[@]+"${!AGG_DSELLBILL[@]}"}; do
+        dayseen["${k%%|*}"]=1
+    done
+    for k in ${AGG_DVOIDBILL[@]+"${!AGG_DVOIDBILL[@]}"}; do
+        dayseen["${k%%|*}"]=1
+    done
+    for d in ${dayseen[@]+"${!dayseen[@]}"}; do
+        days+=("$d")
+    done
+    if (( ${#days[@]} > 0 )); then
+        mapfile -t days < <(printf '%s\n' "${days[@]}" | sort)
+    fi
+
+    echo "${C_BOLD}$(t rep_title)${C_RESET}  —  $s → $e"
+    echo "$(repeat_str '─' 44)"
+
+    local s_epoch e_epoch ncal
+    s_epoch=$(date -d "$s" +%s)
+    e_epoch=$(date -d "$e" +%s)
+    ncal=$(( (e_epoch - s_epoch) / 86400 + 1 ))
+
+    local t_processed=0 t_units=0 t_revenue=0 t_voids=0 dsales=0
+    local processed units revenue voids
+    if (( ${#days[@]} > 0 )); then
+        echo " $(t rep_per_day)"
+        for d in "${days[@]}"; do
+            _day_stats "$d" processed units revenue voids
+            printf '  %s  bills=%d  units=%d  revenue=%s  voided=%d\n' \
+                "$d" "$processed" "$units" "$(fmt_money "$revenue")" "$voids"
+            t_processed=$((t_processed + processed))
+            t_units=$((t_units + units))
+            t_revenue=$((t_revenue + revenue))
+            t_voids=$((t_voids + voids))
+            if (( processed > 0 )); then dsales=$((dsales + 1)); fi
+        done
+        echo
+    fi
+    local avg=0
+    if (( t_processed > 0 )); then avg=$(( t_revenue / t_processed )); fi
+    printf " %s  %d %s %d\n" "$(t rep_days)" "$dsales" "$(t rep_of)" "$ncal"
+    printf " Bills processed:  %d\n" "$t_processed"
+    printf " Units sold:       %d\n" "$t_units"
+    printf " Revenue:          %s\n" "$(fmt_money "$t_revenue")"
+    printf " Average bill:     %s\n" "$(fmt_money "$avg")"
+    printf " Voided bills:     %d\n" "$t_voids"
+    echo
+    echo " ${C_BOLD}$(t rep_top)${C_RESET}"
+    # range-wide net per barcode (sum the per-day nets)
+    local -A rnet=() rqty=()
+    local bc
+    for k in ${AGG_DNETLT[@]+"${!AGG_DNETLT[@]}"}; do
+        bc="${k#*|}"
+        rnet["$bc"]=$(( ${rnet["$bc"]:-0} + ${AGG_DNETLT[$k]} ))
+        rqty["$bc"]=$(( ${rqty["$bc"]:-0} + ${AGG_DNETQTY[$k]:-0} ))
+    done
+    local -a tops=()
+    for bc in ${rnet[@]+"${!rnet[@]}"}; do
+        if (( ${rnet[$bc]} > 0 )); then
+            tops+=("${rnet[$bc]}|${rqty[$bc]:-0}|${bc}|${AGG_BCNAME[$bc]:-?}")
+        fi
+    done
+    local sorted=""
+    if (( ${#tops[@]} > 0 )); then
+        sorted=$(printf '%s\n' "${tops[@]}" | sort -t'|' -k1,1nr | head -5)
+    fi
+    _print_top5 "$sorted" "$(t rep_none)"
+}
