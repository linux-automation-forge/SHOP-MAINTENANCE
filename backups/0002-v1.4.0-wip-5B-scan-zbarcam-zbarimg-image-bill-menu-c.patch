+
+_st_quickbill_parity() {
+    # Identical input through `bill` (stdin) and `quickbill` (argv) must
+    # produce byte-identical CSV rows — except bill_no (sequential) and the
+    # timestamp (wall clock), which differ by design. All other fields must
+    # match exactly because both paths go through the same cmd_bill engine.
+    do_add 8901234500011 "Parity Tea" 5500 10 3 >/dev/null 2>&1 || return 1
+    do_add 8901234500012 "Parity Soap" 3500 10 3 >/dev/null 2>&1 || return 1
+    printf '8901234500011 2\n8901234500012 1\n' | cmd_bill --phone 9876543210 --discount 10 >/dev/null 2>&1 || return 1
+    local rc=0
+    cmd_quickbill --phone 9876543210 --discount 10 8901234500011 2 8901234500012 1 >/dev/null 2>&1 || rc=$?
+    (( rc == 0 )) || return 1
+    local rows b1 b2 q1 q2 i f1 f2
+    rows=$(grep ',SELL,' "$BILLS_CSV" | tail -4)
+    [[ $(printf '%s\n' "$rows" | wc -l) -eq 4 ]] || return 1
+    b1=$(printf '%s\n' "$rows" | sed -n 1p); b2=$(printf '%s\n' "$rows" | sed -n 2p)
+    q1=$(printf '%s\n' "$rows" | sed -n 3p); q2=$(printf '%s\n' "$rows" | sed -n 4p)
+    # fields 3..10 (0-based): barcode,name,qty,unit_price,line_total,action,phone,discount
+    for i in 2 3 4 5 6 7 8 9; do
+        f1=$(printf '%s' "$b1" | cut -d, -f$((i + 1)))
+        f2=$(printf '%s' "$q1" | cut -d, -f$((i + 1)))
+        [[ "$f1" == "$f2" ]] || return 1
+        f1=$(printf '%s' "$b2" | cut -d, -f$((i + 1)))
+        f2=$(printf '%s' "$q2" | cut -d, -f$((i + 1)))
+        [[ "$f1" == "$f2" ]] || return 1
+    done
+    # odd arg count is a usage error (rc 3)
+    cmd_quickbill 8901234500011 >/dev/null 2>&1
+    [[ $? -eq 3 ]] || return 1
+    return 0
+}
