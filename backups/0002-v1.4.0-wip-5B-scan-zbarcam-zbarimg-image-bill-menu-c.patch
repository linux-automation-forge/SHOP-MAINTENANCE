+_st_import_validation() {
+    local tmpl="$ST_TMP/tmpl.csv"
+    cmd_import --template "$tmpl" >/dev/null 2>&1 || return 1
+    [[ -s "$tmpl" ]] || return 1
+    head -1 "$tmpl" | grep -q '^barcode,name,price_paise' || return 1
+    local HDR; HDR=$(head -1 "$tmpl")
+    local good="$ST_TMP/good.csv"
+    { printf '%s\n' "$HDR"
+      printf '8901234600011,Imp Tea,2500,10,4,,Grocery,,,2501\n'
+      printf '8901234600012,Imp Soap,3500,5,2,,Personal Care,,,\n'
+      printf '8901234600013,Imp Dal,9000,7,3,,Staples,,,\n'
+    } > "$good"
+    local psha isha csha
+    psha=$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)
+    isha=$(sha256sum "$INVENTORY_LOG" | cut -d' ' -f1)
+    csha=$(sha256sum "$CATEGORIES_CSV" | cut -d' ' -f1)
+    # dry-run: rc 0, report clean, NOTHING written
+    cmd_import "$good" --dry-run >/dev/null 2>&1 || return 1
+    [[ "$psha" == "$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)" ]] || return 1
+    [[ "$isha" == "$(sha256sum "$INVENTORY_LOG" | cut -d' ' -f1)" ]] || return 1
+    [[ "$csha" == "$(sha256sum "$CATEGORIES_CSV" | cut -d' ' -f1)" ]] || return 1
+    # real import: 3 ADD log rows
+    cmd_import "$good" >/dev/null 2>&1 || return 1
+    (( $(grep -c ',ADD,' "$INVENTORY_LOG") >= 3 )) || return 1
+    grep -q '^8901234600011,' "$PRODUCTS_CSV" || return 1
+    # one bad row -> rc 1 and NOTHING written (all-or-nothing)
+    local bad="$ST_TMP/bad.csv"
+    { printf '%s\n' "$HDR"
+      printf '8901234700001,Ok Item,1000,1,1,,,,,\n'
+      printf 'notdigits,Bad Name,1000,1,1,,,,,\n'
+    } > "$bad"
+    psha=$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)
+    isha=$(sha256sum "$INVENTORY_LOG" | cut -d' ' -f1)
+    csha=$(sha256sum "$CATEGORIES_CSV" | cut -d' ' -f1)
+    cmd_import "$bad" >/dev/null 2>&1 && return 1
+    [[ "$psha" == "$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)" ]] || return 1
+    [[ "$isha" == "$(sha256sum "$INVENTORY_LOG" | cut -d' ' -f1)" ]] || return 1
+    [[ "$csha" == "$(sha256sum "$CATEGORIES_CSV" | cut -d' ' -f1)" ]] || return 1
+    # duplicates vs existing AND within the file are both caught
+    local dup="$ST_TMP/dup.csv"
+    { printf '%s\n' "$HDR"
+      printf '8901234600011,Imp Again,1000,1,1,,,,,\n'
+      printf '8901234800001,InFile A,1000,1,1,,,,,\n'
+      printf '8901234800001,InFile B,1000,1,1,,,,,\n'
+    } > "$dup"
+    local out
+    out=$(cmd_import "$dup" 2>&1) && return 1
+    printf '%s' "$out" | grep -q 'duplicate barcode (exists)' || return 1
+    printf '%s' "$out" | grep -q 'duplicate barcode within file' || return 1
+    return 0
+}
