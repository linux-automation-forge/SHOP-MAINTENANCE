+_st_scan_degrade() {
+    # Restricted PATH with NO zbar tools: scan must print the install hint,
+    # exit 1, and write NOTHING. Then plain billing must still work.
+    local bin="$ST_TMP/nobin"
+    mkdir -p "$bin"
+    local c p
+    for c in bash sh date awk sed sort head tail wc cat cut grep flock mktemp \
+             dirname basename sha256sum tput rm mkdir cp mv env id tr sleep \
+             printf ls od comm stat chmod ln uname; do
+        p=$(command -v "$c" 2>/dev/null) && ln -sf "$p" "$bin/$c"
+    done
+    local bsha; bsha=$(sha256sum "$BILLS_CSV" | cut -d' ' -f1)
+    local out rc=0
+    out=$(PATH="$bin" cmd_scan --image "$ST_TMP/nope.png" 2>&1) || rc=$?
+    (( rc == 1 )) || return 1
+    printf '%s' "$out" | grep -q 'zbar-tools' || return 1
+    [[ "$bsha" == "$(sha256sum "$BILLS_CSV" | cut -d' ' -f1)" ]] || return 1
+    # camera path degrades identically
+    rc=0
+    out=$(PATH="$bin" cmd_scan 2>&1 </dev/null) || rc=$?
+    (( rc == 1 )) || return 1
+    printf '%s' "$out" | grep -q 'zbar-tools' || return 1
+    # ...and normal billing is completely unaffected
+    do_add 8901234500211 "Degrade Tea" 1000 5 2 >/dev/null 2>&1 || return 1
+    printf '8901234500211 1\n' | cmd_bill >/dev/null 2>&1 || return 1
+    grep -q ',SELL,' "$BILLS_CSV" || return 1
+    return 0
+}
