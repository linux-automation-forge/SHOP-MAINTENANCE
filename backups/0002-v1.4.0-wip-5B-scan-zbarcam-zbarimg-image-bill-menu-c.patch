+_st_report_matches_summary() {
+    # Seed 3 synthetic days (incl. a CROSS-DAY void) straight into bills.csv,
+    # then prove: report totals == sum of per-day `summary` runs.
+    local next; next=$(read_state next_bill_no)
+    [[ -n "$next" ]] || next=1
+    local d1=2026-09-01 d2=2026-09-02 d3=2026-09-05
+    printf '%s,%s 10:00:00,7000101,Rep Tea,2,2500,5000,SELL,9100000000,0\n' "$next" "$d1"     >> "$BILLS_CSV"
+    printf '%s,%s 10:00:00,7000102,Rep Soap,1,3500,3500,SELL,9100000000,0\n' "$next" "$d1"     >> "$BILLS_CSV"
+    printf '%s,%s 11:00:00,7000103,Rep Dal,3,900,2700,SELL,,0\n'             "$((next+1))" "$d2" >> "$BILLS_CSV"
+    printf '%s,%s 12:00:00,7000103,Rep Dal,3,900,2700,VOID,,0\n'             "$((next+2))" "$d3" >> "$BILLS_CSV"
+    printf '%s,%s 09:30:00,7000104,Rep Bisc,1,2000,2000,SELL,,0\n'           "$((next+3))" "$d3" >> "$BILLS_CSV"
+    write_state next_bill_no $((next + 4))
+    # expected per-day semantics: d2 keeps its bill (void lands on d3);
+    # revenue = 8500 + 2700 + 2000 = 13200; processed = 3; voids = 1 (d3)
+    local out
+    out=$(cmd_report 2026-09-01 2026-09-05) || return 1
+    printf '%s' "$out" | grep -q 'Bills processed:  3'   || return 1
+    printf '%s' "$out" | grep -q 'Units sold:       7'   || return 1
+    printf '%s' "$out" | grep -q 'Voided bills:     1'  || return 1
+    printf '%s' "$out" | grep -q "Revenue:          $(fmt_money 13200)$" || return 1
+    printf '%s' "$out" | grep -q 'Days with sales:  3 ' || return 1
+    # per-day lines present with correct numbers
+    printf '%s' "$out" | grep -q "  2026-09-02  bills=1  units=3  revenue=$(fmt_money 2700)  voided=0" || return 1
+    printf '%s' "$out" | grep -q "  2026-09-05  bills=1  units=1  revenue=$(fmt_money 2000)  voided=1" || return 1
+    # rejected: end<start, garbage dates, missing args
+    cmd_report 2026-09-05 2026-09-01 >/dev/null 2>&1 && return 1
+    cmd_report 2026-13-40 2026-09-07 >/dev/null 2>&1 && return 1
+    cmd_report bad >/dev/null 2>&1 && return 1
+    # THE equality proof: report totals == sum of per-day summary runs
+    local d sum_proc=0 sum_units=0 sum_rev=0 sum_void=0 line val pv
+    for d in 2026-09-01 2026-09-02 2026-09-03 2026-09-04 2026-09-05; do
+        out=$(cmd_summary "$d")
+        for line in "Bills processed" "Units sold" "Revenue" "Voided bills"; do
+            val=$(printf '%s\n' "$out" | grep "$line:" | grep -oE '[0-9]+(\.[0-9]{2})?$')
+            case "$line" in
+                "Bills processed") sum_proc=$((sum_proc + 10#$val)) ;;
+                "Units sold")      sum_units=$((sum_units + 10#$val)) ;;
+                "Revenue")         pv=$(_paise_of "$val"); sum_rev=$((sum_rev + 10#$pv)) ;;
+                "Voided bills")    sum_void=$((sum_void + 10#$val)) ;;
+            esac
+        done
+    done
+    out=$(cmd_report 2026-09-01 2026-09-05)
+    [[ "$sum_proc"  == "$(printf '%s\n' "$out" | grep 'Bills processed:' | grep -oE '[0-9]+$')" ]] || return 1
+    [[ "$sum_units" == "$(printf '%s\n' "$out" | grep 'Units sold:'     | grep -oE '[0-9]+$')" ]] || return 1
+    [[ "$sum_void"  == "$(printf '%s\n' "$out" | grep 'Voided bills:'   | grep -oE '[0-9]+$')" ]] || return 1
+    [[ "$sum_rev"   == "13200" ]] || return 1
+    return 0
+}
+
+_paise_of() {   # "Rs123.45" | "₹123.45" -> 12345 (helper for the report test)
+    local s="$1"
+    s="${s#₹}"; s="${s#Rs}"; s="${s# }"
+    local ip="${s%%.*}" fp="0"
+    if [[ "$s" == *.* ]]; then fp="${s#*.}"; fi
+    printf '%s' "$(( 10#$ip * 100 + 10#$fp ))"
+}
