+_st_upi_uri() {
+    # no vpa configured -> must fail
+    cmd_config upi_vpa "" >/dev/null 2>&1
+    upi_uri 100 >/dev/null 2>&1 && return 1
+    cmd_config upi_vpa "kirana@upi" >/dev/null 2>&1 || return 1
+    local uri
+    uri=$(upi_uri 25050 "Bill 7") || return 1
+    [[ "$uri" == "upi://pay?pa=kirana%40upi&pn="*"&am=250.50&cu=INR&tn=Bill+7" ]] || return 1
+    # paise < 10 must zero-pad (0.05, not 0.5)
+    uri=$(upi_uri 5) || return 1
+    [[ "$uri" == *"am=0.05&cu=INR" ]] || return 1
+    # bad amount rejected
+    upi_uri "12ab" >/dev/null 2>&1 && return 1
+    # upi_qr is a callable function that writes a real file (zint PNG or SVG)
+    local f
+    f=$(upi_qr 1250 "st test" "$LABELS_DIR/st-upi.png") || return 1
+    [[ -s "$f" ]] || return 1
+    cmd_config upi_vpa "" >/dev/null 2>&1
+    return 0
+}
