+# ── UPI QR ───────────────────────────────────────────────────────────────────
+# One conf key (upi_vpa) enables UPI payments. The URI is the standard intent
+# format every Indian UPI app accepts:
+#   upi://pay?pa=<vpa>&pn=<shop>&am=<amount>&cu=INR[&tn=<note>]
+# upi_uri PRINTS the URI (callable; rc 1 if upi_vpa unset). upi_qr renders it
+# through the existing gen-qr path (zint PNG, else SVG) and prints the path.
+upi_uri() {
+    local paise="$1" note="${2:-}"
+    if ! [[ "$paise" =~ ^[0-9]+$ ]]; then
+        err "upi_uri: amount must be integer paise"
+        return 1
+    fi
+    local vpa
+    vpa=$(conf upi_vpa "")
+    if [[ -z "$vpa" ]]; then
+        err "UPI not configured. Set once: ./shopkeep.sh config upi_vpa yourname@upi"
+        return 1
+    fi
+    local rs=$(( paise / 100 )) ps=$(( paise % 100 ))
+    local uri
+    uri="upi://pay?pa=$(url_encode "$vpa")&pn=$(url_encode "$(conf shop_name "My Kirana Store")")"
+    uri+="&am=$(printf '%d.%02d' "$rs" "$ps")&cu=INR"
+    [[ -n "$note" ]] && uri+="&tn=$(url_encode "$note")"
+    printf '%s' "$uri"
+}
+
+upi_qr() {
+    local paise="$1" note="${2:-}" out="${3:-}"
+    local uri
+    uri=$(upi_uri "$paise" "$note") || return 1
+    [[ -n "$out" ]] || out="$LABELS_DIR/upi-$(TZ=Asia/Kolkata date +%s).png"
+    gen_qr_code "$uri" "$out"
+}
+
+cmd_upi_qr() {
+    local amount="${1:-}"
+    if [[ -z "$amount" ]]; then
+        err "Usage: shopkeep.sh upi-qr <amount> [note] [out.png]   (e.g. upi-qr 250.50)"
+        return 3
+    fi
+    local paise
+    paise=$(rupees_to_paise "$amount") || { err "Invalid amount '$amount' (use 250, 250.5, or 250.50)"; return 1; }
+    if (( paise <= 0 )); then
+        err "amount must be > 0"
+        return 1
+    fi
+    local f
+    f=$(upi_qr "$paise" "${2:-}" "${3:-}") || return 1
+    log "UPI QR ($amount): $f"
+}
+
+# One UPI QR block under a SAVED bill receipt (no-op unless upi_vpa is set).
+print_upi_line() {
+    local bill_no="$1" net="$2"
+    if [[ -z "$(conf upi_vpa "")" ]]; then return 0; fi
+    local qr
+    qr=$(upi_qr "$net" "Bill $bill_no" "$LABELS_DIR/upi-bill${bill_no}.png") || return 0
+    printf '%s\n' " $(t upi_scan_to_pay): $qr"
+}
