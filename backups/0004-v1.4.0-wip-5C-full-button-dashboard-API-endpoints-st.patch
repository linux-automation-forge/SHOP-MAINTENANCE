+# v1.4.0 Phase 5C — one-command launcher for the local button dashboard.
+#   start: regenerate the dashboard, launch shopkeep-web.py in the background
+#          (pidfile shopkeep-data/server.pid, log shopkeep-data/server.log),
+#          wait for the port, open the browser. Re-running is safe.
+#   stop:  kill EXACTLY the pid in the pidfile (never pkill by name).
+#─────────────────────────────────────────────────────────────────────────────
+WEB_URL="http://127.0.0.1:8000"
+
+cmd_start() {
+    init_dirs
+    command -v python3 >/dev/null || { err "python3 is required for the dashboard server"; return 2; }
+    local pidfile="$DATA_DIR/server.pid"
+    exec 201>"$pidfile.lock"; flock 201          # serialise concurrent start/stop
+    if [[ -f "$pidfile" ]]; then
+        local pid; pid=$(cat "$pidfile" 2>/dev/null || true)
+        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
+            echo "Already running (pid $pid) at $WEB_URL"
+            flock -u 201 2>/dev/null; exec 201>&- 2>/dev/null
+            return 0
+        fi
+        rm -f "$pidfile"                          # stale pid after a crash/power cut
+    fi
+    log "Regenerating dashboard…"
+    cmd_web || true
+    log "Starting the shopkeep dashboard server…"
+    ( cd "$SCRIPT_DIR" && exec nohup python3 shopkeep-web.py >>"$DATA_DIR/server.log" 2>&1 ) &
+    echo $! > "$pidfile"
+    local pid2 up=0 i
+    pid2=$(cat "$pidfile" 2>/dev/null || true)
+    for ((i=0; i<25; i++)); do
+        if ! kill -0 "$pid2" 2>/dev/null; then break; fi
+        if (exec 3<>/dev/tcp/127.0.0.1/8000) 2>/dev/null; then up=1; break; fi
+        sleep 0.2
+    done
+    flock -u 201 2>/dev/null; exec 201>&- 2>/dev/null
+    if (( ! up )); then
+        rm -f "$pidfile"
+        if kill -0 "$pid2" 2>/dev/null; then
+            err "Server did not open port 8000 after 5s — see $DATA_DIR/server.log"
+        else
+            err "Server failed to start (is port 8000 busy?) — see $DATA_DIR/server.log"
+        fi
+        return 1
+    fi
+    echo
+    box_top
+    box_center "Shop dashboard is ON"
+    box_center "$WEB_URL"
+    box_bottom
+    echo
+    if command -v xdg-open >/dev/null 2>&1; then
+        ( xdg-open "$WEB_URL" >/dev/null 2>&1 & ) || true
+        log "Opening $WEB_URL in your browser…"
+    else
+        log "Open $WEB_URL in your browser (Chrome/Edge recommended)."
+    fi
+    return 0
+}
+
+cmd_stop() {
+    init_dirs
+    local pidfile="$DATA_DIR/server.pid"
+    exec 201>"$pidfile.lock"; flock 201
+    if [[ ! -f "$pidfile" ]]; then
+        log "Not running (no pid file)."
+        flock -u 201 2>/dev/null; exec 201>&- 2>/dev/null
+        return 0
+    fi
+    local pid; pid=$(cat "$pidfile" 2>/dev/null || true)
+    if ! [[ "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
+        rm -f "$pidfile"
+        log "Stale pid file removed — server was not running."
+        flock -u 201 2>/dev/null; exec 201>&- 2>/dev/null
+        return 0
+    fi
+    kill "$pid" 2>/dev/null || true
+    local i
+    for ((i=0; i<10; i++)); do
+        kill -0 "$pid" 2>/dev/null || break
+        sleep 0.2
+    done
+    if kill -0 "$pid" 2>/dev/null; then
+        kill -9 "$pid" 2>/dev/null || true
+    fi
+    rm -f "$pidfile"
+    flock -u 201 2>/dev/null; exec 201>&- 2>/dev/null
+    log "Stopped (pid $pid)."
+}
+
