+# ---------------------------------------------------------------------
+# Small validation helpers — everything is rejected HERE, before any
+# subprocess runs (same discipline as /api/bill's discount check).
+# ---------------------------------------------------------------------
+def bad(msg):
+    return {"ok": False, "exitCode": 1, "stdout": "", "stderr": msg}
+
+
+def clean_str(v, maxlen=200):
+    """String field for a CSV/conf write: strip control chars that would
+    corrupt line-oriented files. Length-capped."""
+    if v is None:
+        return ""
+    s = str(v).replace("\r", " ").replace("\n", " ").replace("\t", " ")
+    return s.strip()[:maxlen]
+
+
+def run_shop(args, stdin_text=None):
+    """Run ./shopkeep.sh with LIST args (never a shell). Returns the uniform
+    {ok, exitCode, stdout, stderr} result dict."""
+    cmd = [SHOPKEEP] + [str(a) for a in args]
+    try:
+        proc = subprocess.run(cmd, input=stdin_text, capture_output=True,
+                              text=True, timeout=SUBPROC_TIMEOUT, cwd=HERE)
+        return {"ok": proc.returncode == 0, "exitCode": proc.returncode,
+                "stdout": proc.stdout, "stderr": proc.stderr}
+    except subprocess.TimeoutExpired:
+        return {"ok": False, "exitCode": -1, "stdout": "",
+                "stderr": "shopkeep.sh %s timed out" % " ".join(args)}
+    except FileNotFoundError:
+        return {"ok": False, "exitCode": -1, "stdout": "",
+                "stderr": "shopkeep.sh not found at " + SHOPKEEP}
+
 
