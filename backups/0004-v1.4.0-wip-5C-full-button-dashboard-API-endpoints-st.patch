+# ---------------------------------------------------------------------
+def ep_add(p):
+    name = clean_str(p.get("name"), 120)
+    price = str(p.get("price") or "").strip()
+    qty = str(p.get("qty") or "").strip()
+    bc = str(p.get("barcode") or "").strip()
+    thr = str(p.get("threshold") or "").strip()
+    expiry = str(p.get("expiry") or "").strip()
+    desc = clean_str(p.get("desc"), 200)
+    ptype = clean_str(p.get("type"), 60)
+    hsn = clean_str(p.get("hsn"), 20)
+    if not name:
+        return bad("Please enter a product name.")
+    if not RE_MONEY.match(price):
+        return bad("Price must be a number like 25 or 25.50 (no minus sign).")
+    if not RE_INT.match(qty):
+        return bad("Qty must be a whole number (0 or more).")
+    if bc and not RE_BARCODE.match(bc):
+        return bad("Barcode must be digits only (max 14).")
+    if thr and not RE_INT.match(thr):
+        return bad("Threshold must be a whole number.")
+    if expiry and not RE_DATE.match(expiry):
+        return bad("Expiry must be a date like 2025-12-31.")
+    args = ["add", "--name", name, "--price", price, "--qty", qty]
+    if bc:
+        args += ["--barcode", bc]
+    if thr:
+        args += ["--threshold", thr]
+    if desc:
+        args += ["--desc", desc]
+    if ptype:
+        args += ["--type", ptype]
+    if expiry:
+        args += ["--expiry", expiry]
+    if hsn:
+        args += ["--hsn", hsn]
+    return run_shop(args)
+
+
+def ep_edit(p):
+    bc = str(p.get("barcode") or "").strip()
+    if not RE_BARCODE.match(bc):
+        return bad("Barcode must be digits only (max 14).")
+    fields = []
+    for key, label in (("name", 120), ("desc", 200), ("type", 60),
+                       ("hsn", 20)):
+        v = p.get(key)
+        if v is not None and str(v).strip() != "":
+            fields += ["--" + key if key != "desc" else "--desc",
+                       clean_str(v, label)]
+    if p.get("price") not in (None, ""):
+        price = str(p.get("price")).strip()
+        if not RE_MONEY.match(price):
+            return bad("Price must be a number like 25 or 25.50.")
+        fields += ["--price", price]
+    if p.get("threshold") not in (None, ""):
+        thr = str(p.get("threshold")).strip()
+        if not RE_INT.match(thr):
+            return bad("Threshold must be a whole number.")
+        fields += ["--threshold", thr]
+    if p.get("expiry") not in (None, ""):
+        expiry = str(p.get("expiry")).strip()
+        if expiry != "-" and not RE_DATE.match(expiry):
+            return bad("Expiry must be a date like 2025-12-31 (or - to clear).")
+        fields += ["--expiry", expiry]
+    if not fields:
+        return bad("Nothing to change — fill at least one field.")
+    return run_shop(["edit", bc] + fields)
