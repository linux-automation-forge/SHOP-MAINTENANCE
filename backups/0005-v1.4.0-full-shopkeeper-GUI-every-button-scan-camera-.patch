+# v1.4.0 (5D): one happy/fail pair per endpoint family that had no selftest
+# coverage yet (add-dup / edit / config / void / backup), plus a cheap
+# version-consistency check (-V output and the dashboard meta agree).
+_st_add_dup() {
+    do_add "7601" "DupTest" 1000 5 1 >/dev/null 2>&1 || return 1
+    local before after
+    before=$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)
+    if do_add "7601" "DupTest2" 2000 3 1 >/dev/null 2>&1; then return 1; fi
+    after=$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)
+    [[ "$before" == "$after" ]] || return 1
+    local n; n=$(awk -F',' '$1=="7601"' "$PRODUCTS_CSV" | wc -l)
+    [[ "$n" == "1" ]] || return 1
+    return 0
+}
+
+_st_edit_pair() {
+    do_add "7602" "EditTest" 1000 5 1 >/dev/null 2>&1 || return 1
+    cmd_edit "7602" --price 12.50 >/dev/null 2>&1 || return 1
+    local pp; pp=$(awk -F',' '$1=="7602"{print $3}' "$PRODUCTS_CSV")
+    [[ "$pp" == "1250" ]] || return 1
+    local before after
+    before=$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)
+    if cmd_edit "7602" --price "abc" >/dev/null 2>&1; then return 1; fi
+    after=$(sha256sum "$PRODUCTS_CSV" | cut -d' ' -f1)
+    [[ "$before" == "$after" ]] || return 1
+    return 0
+}
+
+_st_config_allowlist() {
+    # happy: allowlisted key is set and reads back
+    cmd_config shop_name "ST Allowlist Shop" >/dev/null 2>&1 || return 1
+    [[ "$(conf shop_name "")" == "ST Allowlist Shop" ]] || return 1
+    # fail: unknown key rejected AND shopkeep.conf left byte-identical
+    local before after
+    before=$(sha256sum "$CONF_FILE" | cut -d' ' -f1)
+    if cmd_config nuclear_codes "x" >/dev/null 2>&1; then return 1; fi
+    after=$(sha256sum "$CONF_FILE" | cut -d' ' -f1)
+    [[ "$before" == "$after" ]] || return 1
+    return 0
+}
+
+_st_void_pair() {
+    do_add "7603" "VoidTest" 1000 10 1 >/dev/null 2>&1 || return 1
+    BILL_PHONE=""; BILL_DISCOUNT_PCT="0"
+    commit_bill "7603 3" >/dev/null 2>&1 || return 1
+    local bno="$BILL_NO"
+    void_bill "$bno" 0 >/dev/null 2>&1 || return 1
+    local q; q=$(awk -F',' '$1=="7603"{print $4}' "$PRODUCTS_CSV")
+    [[ "$q" == "10" ]] || return 1                      # stock restored
+    awk -F',' -v b="$bno" '$1==b && $8=="VOID"{f=1} END{exit !f}' "$BILLS_CSV" || return 1
+    local before after
+    before=$(sha256sum "$BILLS_CSV" | cut -d' ' -f1)
+    if void_bill 987654 0 >/dev/null 2>&1; then return 1; fi   # no such bill
+    after=$(sha256sum "$BILLS_CSV" | cut -d' ' -f1)
+    [[ "$before" == "$after" ]] || return 1
+    return 0
+}
+
+_st_backup_pair() {
+    mkdir -p "$BACKUPS_DIR"
+    backup_now >/dev/null 2>&1 || return 1
+    local newest; newest=$(ls -1t "$BACKUPS_DIR"/shopkeep-*.tar.gz 2>/dev/null | head -1)
+    [[ -s "$newest" ]] || return 1
+    tar -tzf "$newest" 2>/dev/null | grep -q "products.csv" || return 1
+    # fail path: tar missing -> graceful rc!=0 and NO partial archive left
+    local n_before n_after
+    n_before=$(ls -1 "$BACKUPS_DIR"/shopkeep-*.tar.gz 2>/dev/null | wc -l)
+    if ( PATH="/nonexistent" backup_now ) >/dev/null 2>&1; then return 1; fi
+    n_after=$(ls -1 "$BACKUPS_DIR"/shopkeep-*.tar.gz 2>/dev/null | wc -l)
+    [[ "$n_before" == "$n_after" ]] || return 1
+    return 0
+}
+
+_st_version_consistency() {
+    [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
+    local v
+    v=$(SHOPKEEP_DATA_DIR="$ST_TMP/sv-data" bash "$SCRIPT_DIR/shopkeep.sh" -V 2>/dev/null)
+    [[ "$v" == "shopkeep.sh $VERSION" ]] || return 1
+    DASHBOARD_HTML="$ST_TMP/version-check.html"
+    local okweb=1
+    cmd_web >/dev/null 2>&1 || okweb=0
+    if (( okweb )); then
+        grep -q "\"version\":\"$VERSION\"" "$DASHBOARD_HTML" || okweb=0
+    fi
+    rm -f "$DASHBOARD_HTML"; DASHBOARD_HTML=""
+    (( okweb ))
+}
